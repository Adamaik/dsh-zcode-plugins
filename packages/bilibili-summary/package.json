  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "python",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.2-rc.1 || ^0.2.0-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
